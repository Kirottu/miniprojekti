@using System.ComponentModel
@using System.ComponentModel.DataAnnotations
@using System.Linq
@using miniprojekti.Components.Pages
@inject ILogger<ReferenceForm> Logger
<!-- Lomake viitteiden luomiseen. -->


<h2 class="mt-4">Add reference </h2>
<div class="formdiv">
  <EditForm Model="Model" OnValidSubmit="HandleSubmit" FormName="ReferenceForm">
    <fieldset>
      <div class="reference-form">
        <label for="title">Title: </label>
        <br/>
        <input type="text" name="title" id="title" class="title" required/>
        <br/>
        <label for="type">Type: </label>
        <select name="types" id="type-select" required>
          <option value="">--Select type--</option>
          @foreach (var type in entryTypes)
          {
            <option value=@type>@type</option>
          }
        </select>
        <br/>
        <label for="key">Key: </label>
        <input type="text" name="key" id="key" required/>
      </div>
    </fieldset>
    <fieldset>
      <legend>Add authors</legend>
      <div class="reference-form">
        @* <label for="authorFirstName">First Name: </label>
        <input type="text" @bind-value="_authorFirstName" name="authorFirstName" id="authorFirstName"/>
        <label for="authorLastName">Surname: </label>
        <input type="text" @bind-value="_authorLastName" name="authorLastName" id="authorLastName" /> *@
        <label for="authorName">Author name:</label>
        <input type="text" @bind-value="_authorName" name="authorName" id="authorName" />
        
      </div>
      <button type="button" @onclick="SaveAuthorToForm">Add author</button>
      @if (Model?.Authors != null && Model.Authors.Count > 0)
      {
        <p><strong>Added authors:</strong></p>
        @for (int i = 0; i < Model.Authors.Count; i++)
        {
          <p>@Model.Authors[i] @Model.Authors[i]</p>
        }
      }
    </fieldset>
    
    <div class="reference-form">
      <fieldset>
        <datalist id="bibtex-standard-fields">
          @for (int i = 0; i < fields.Length; i++)
          {
            <option value=@fields[i]></option>
          }
        </datalist>
        <div>
          <legend>Add new field</legend>
          <label for="addField">New field: </label>
          <input type="text" list="bibtex-standard-fields" name="addField" id="addField"  @bind-value="_fieldName"/>

          <!-- Voisi mahdollisesti myös käyttää select
          <select name="addField" id="addField">
            <option value="test">Test</option>
          </select>
          -->

          <label for="addFieldValue">Value: </label>
          <input type="text" name="addFieldValue" id="addFieldValue" @bind-value="_fieldValue"/>
        </div>
        <p class="error">@fieldErrorMsg</p>
        <button type="button" @onclick="SaveFieldToForm">Add field</button>
        @if (Model?.Fields != null && Model.Fields.ToList().Count > 0)
        {
          <p><strong>Added fields:</strong></p>
          @foreach (string key in Model.Fields.Keys)
          {
              <p><strong>Field:</strong> @key, <strong>Value:</strong> @GetValueFromField(key)</p>
          }
        }
      </fieldset>
    </div>
    <div class="reference-form">
      <input type="submit" value="Add reference" />
    </div>
  </EditForm>
</div>
<p>@test</p>

@code {

    [SupplyParameterFromForm]
    private Reference? Model { get; set; }

    [Parameter]
    public List<Home.MockViite>? MockViitteet { get; set; }
    protected override void OnInitialized() => Model ??= new();


    //private string _authorFirstName = string.Empty;
    //private string _authorLastName = string.Empty;
    private string _authorName = string.Empty;


    // Standard entry types
    private string[] entryTypes = [
    "article",
  "book",
  "booklet",
  "conference",
  "inbook",
  "incollection",
  "inproceedings",
  "manual",
  "mastersthesis",
  "misc",
  "phdthesis",
  "proceedings",
  "techreport",
  "unpublished"
    ];

    // Standard fields from https://www.bibtex.org/Format/#standard-fields
    private string[] fields =
  [
    "address",
  "annote",
  "booktitle",
  "chapter",
  "crossref",
  "edition",
  "editor",
  "howpublished",
  "institution",
  "journal",
  "key",
  "month",
  "note",
  "number",
  "organization",
  "pages",
  "publisher",
  "school",
  "series",
  "volume",
  "year",
  // Other widely used fields
  "doi",
  "url",
  "isbn",
  "issn",
  "eprint",
  "urldate"
    ];
    private string _fieldName = string.Empty;
    private string fieldErrorMsg = string.Empty;
    private string _fieldValue = string.Empty;

    private String test = "";
    private void HandleSubmit()
    {

    if (Model == null) return;
    if (Model.Authors.Count < 1) {
      test = "Kirjoittajia tulisi olla enemmän kuin 1";
      return;
    }
    test = "Submit painettu, näytetään tietoa lisätystä lähteestä tulevaisuudessa";

    // Adding as a mock reference to test implementation
    // Before adding to real database
    //await AddMockReference(Model.Title, Model.Type, Model.Key, Model.Authors, Model.Fields);

    Model.Type = String.Empty;
    //Model.Authors = new List<(string, string)>();
    Model.Authors = new List<string>();
    Model.Fields = new Dictionary<string, string>();
    
  }

  private void SaveAuthorToForm()
  {
    // Save name into form
    //Model?.Authors.Add((_authorFirstName.Trim(), _authorLastName.Trim()));
    Model?.Authors.Add(_authorName.Trim());
    _authorName = string.Empty;

    @* _authorFirstName = string.Empty;
    _authorLastName = string.Empty; *@

  }

  private void SaveFieldToForm()
  {
    if (Model == null) return;
    string fname = _fieldName.Trim().ToLower();
    string fvalue = _fieldValue.Trim();

    fieldErrorMsg = "";
    if (!fields.Contains(fname)) fieldErrorMsg = "Field should be chosen from one of preset values";

    if (!fieldErrorMsg.Equals("")) return;

    string? value;
    if (Model.Fields.TryGetValue(fname, out value))
    {
      return;
    }
    Model?.Fields.Add(fname, fvalue);

    _fieldName = string.Empty;
    _fieldValue = string.Empty;
  }

  private string? GetValueFromField(string field)
  {
    string? value = "";
    Model?.Fields.TryGetValue(field, out value);

    return value;
  }

  // This is to add mock reference to test functionality
  /*
  [Parameter]
  public EventCallback<(string? title, string? type, string? key, List<(string firstName, string surname)> authors, Dictionary<string, string> fields)> OnReferenceAdd { get; set; }

  private async Task AddMockReference(string? title, string? type, string? key, List<(string firstName, string surname)> authors, Dictionary<string, string> fields)
  {
    
    await OnReferenceAdd.InvokeAsync((title, type, key, authors, fields));
  }
  */

  public class Reference
  {
    [Required]
    public string? Title { get; set; }
    [Required]
    public string? Type { get; set; }
    [Required]
    public string? Key { get; set; }
    [Required(ErrorMessage = "There should be at least 1 author")]
    [MinLength(1, ErrorMessage = "There should be at least 1 author")]
    //public List<(string firstName, string surname)> Authors { get; set; } = new List<(string, string)>();
    public List<string> Authors { get; set; } = new List<string>();

    public Dictionary<String, String> Fields = new Dictionary<string, string>();

  }

    
}